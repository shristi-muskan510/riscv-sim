# Code for testing branch instructions (SB Format)

0 => x"00500093", -- addi x1, x0, 5 (0)  [x1 = 5]
1 => x"00500113", -- addi x2, x0, 5 (4)  [x2 = 5]
2 => x"00208463", -- beq x1, x2, +8 (8)  [jumps to pc 16]
3 => x"002081B3", -- add x3, x1, x2 (12) [get skipped]
4 => x"00208233", -- add x4, x1, x2 (16) [x4 = 10]
5 => x"00402023", -- sw x4, 0(x0) (20)   [mem[0] = 10]
--------- x1 = 5, x2 = 5, x4 = 10 ---------

# Code for testing JAL instructions ()

0 => x"00500093", -- addi x1, x0, 5 (0)   [x1 = 5]
1 => x"0080016F", -- jal x2, +8 (4)       [x2 = 8, jumps to pc = 12]
2 => x"00A08093", -- addi x1, x1, 10 (8)  [gets skipped]
3 => x"01408093", -- addi x1, x1, 20 (12) [x1 = 25]
4 => x"000001EF", -- jal x3, +0 (16)      [loops till end]
------------ x1 = 25, x2 = 8 ------------

# Code for testing LUI, AUIPC (U Format)

4 => x"001232B7", -- lui x5, 0x123 (16)   [x5 = 1191936]
5 => x"00010217", -- auipc x4, 0x10  (20) [x4 = 65556]
-------- x4 = 65556, x5 = 1191936 -------

# Code for testing JALR

0 => x"00A00093", -- addi x1, x0, 10 (0) [x1 = 10]
1 => x"008002EF", -- jal x5, +8 (4)      [x5 = 8, jumps to pc 12]
2 => x"06308093", -- addi x1, x1, 99 (8) [get skipped first] [x1 = 114]
3 => x"00508093", -- addi x1, x1, 5 (12) [x1 = 15]
4 => x"00028067", -- jalr x0, x5, 0 (16) [jumps to pc 8]
------------ x1 = 114, x5 = 8 ------------